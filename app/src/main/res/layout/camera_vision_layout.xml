<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A">

    <androidx.cardview.widget.CardView
        android:id="@+id/camera_container"
        android:layout_width="match_parent"
        android:layout_height="350dp"
        android:layout_centerInParent="true"
        android:layout_margin="10dp"
        app:cardBackgroundColor="#000"
        app:cardCornerRadius="15dp">

        <!-- عرض الكاميرا -->
        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- طبقة رسم النقاط (MediaPipe Overlay) -->
        <com.saber.supervc.OverlayView
            android:id="@+id/overlayView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- خط ديكوري سبراني -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="50dp"
            android:background="#4000D4FF" />

        <!-- زر التبديل بين الكاميرا الأمامية والخلفية -->
        <ImageButton
            android:id="@+id/btn_switch_camera"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="#60000000"
            android:contentDescription="Switch Camera"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_rotate"
            app:tint="#00D4FF" />

    </androidx.cardview.widget.CardView>

    <!-- منطقة السجلات والتحليل -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/camera_container"
        android:layout_margin="10dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="SYSTEM_ANALYSIS_LOG:"
            android:textColor="#00D4FF"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tv_console_logs"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="#1100D4FF"
            android:fontFamily="monospace"
            android:padding="5dp"
            android:text="> Initializing MediaPipe...\n> Searching for Arduino...\n> Status: Connected"
            android:textColor="#00FF41"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- عنوان المحرك -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:letterSpacing="0.2"
        android:text="SABER_VISION_ENGINE v1.0"
        android:textColor="#00D4FF"
        android:textStyle="bold" />

</RelativeLayout>
